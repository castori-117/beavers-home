---
import '../styles/components/seal.css';
import '../styles/components/home.css';
import '../styles/components/chat.css';
import '../styles/components/care.css';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import AiChat from '../components/AiChat.astro';
import Label from '../components/Label.astro';
import Seal from '../components/Seal.astro';
import { images, thumbFor } from '../lib/images';
import { terms } from '../lib/text';
import { chapterKeys, copy, routes, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const h = t.home;
const indexKeys = [...chapterKeys, 'contact'] as const;
const care = h.care;
---
<Base lang={lang} page="home" intro>
  <home-intro slot="before">
    <button class="intro" type="button" aria-label={h.skipIntro} data-skip>
      <span class="intro-skip" aria-hidden="true">{h.skip}</span>
    </button>
  </home-intro>

  <section class="hero" aria-label={h.opening}>
    <lake-ripples class="hero-media">
      <Image class="hero-img" src={images.lakeDawn} widths={[640, 960, 1280, 1600, 2000, 2400]} sizes="100vw" alt={h.heroAlt} loading="eager" fetchpriority="high" decoding="async" />
      <div class="mist" aria-hidden="true"></div>
      <canvas class="hero-rip" aria-hidden="true"></canvas>
    </lake-ripples>
    <div class="hero-c">
      <div class="seal-slot">
        <div class="seal"><Seal lang={lang} /></div>
      </div>
      <h1 class="d1 hero-h" set:html={h.title} />
    </div>
    <div class="hero-foot">
      <p class="hero-sub" set:html={terms(h.sub)} />
      <span class="hint" aria-hidden="true"><i></i><span class="hint-hover">{h.hintHover}</span><span class="hint-touch">{h.hintTouch}</span></span>
      <a class="btn hero-cta" href={routes[lang].contact}><span>{h.cta}<span class="xs-hide">{h.ctaMore}</span></span> <span class="ar" aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="sec w mf" aria-labelledby="mf-t">
    <div class="g">
      <Label class="rv mf-lab" k={h.prologue.k} v={h.prologue.v} />
      <p id="mf-t" class="st rv">
        <Fragment set:html={h.manifesto[0]} /> <span class="pill" aria-hidden="true"><Image src={images.lakeNight} widths={[160, 320]} sizes="8em" alt="" loading="lazy" decoding="async" /></span><Fragment set:html={h.manifesto[1]} /> <span class="pill" aria-hidden="true"><Image src={images.lakeMorning} widths={[160, 320]} sizes="8em" alt="" loading="lazy" decoding="async" /></span><Fragment set:html={h.manifesto[2]} />
      </p>
      <div class="mf-foot rv">
        <p class="p">{h.manifestoFoot}</p>
        <a class="ln" href={routes[lang].night}>{h.manifestoLink} <span class="ar" aria-hidden="true">→</span></a>
      </div>
    </div>
  </section>

  <section class="sec sec--flush w cu" aria-labelledby="cu-t">
    <div class="g">
      <Label class="cu-lab lab--head rv" k={care.k} v={care.v} />
      <h2 id="cu-t" class="d2 cu-h rv" set:html={care.title} />
      <p class="lead cu-lead rv">{care.lead}</p>
    </div>
    <figure class="cu-proof">
      <div class="cu-sheet rv" aria-hidden="true">
        <svg class="cu-draw" viewBox="0 0 640 440" fill="none">
          <rect class="cu-page" x="40" y="24" width="400" height="392" rx="10"></rect>
          <rect class="cu-bar" x="40" y="24" width="400" height="44" rx="10"></rect>
          <rect class="cu-tone" x="64" y="40" width="72" height="12" rx="3"></rect>
          <rect class="cu-tone2" x="300" y="42" width="40" height="8" rx="2"></rect>
          <rect class="cu-tone2" x="350" y="42" width="40" height="8" rx="2"></rect>
          <rect class="cu-tone2" x="400" y="42" width="20" height="8" rx="2"></rect>
          <rect class="cu-hero" x="64" y="88" width="352" height="150" rx="6"></rect>
          <rect class="cu-ink" x="84" y="190" width="170" height="16" rx="3"></rect>
          <rect class="cu-ink2" x="84" y="214" width="110" height="8" rx="2"></rect>
          <rect class="cu-card" x="64" y="258" width="108" height="132" rx="6"></rect>
          <rect class="cu-card" x="186" y="258" width="108" height="132" rx="6"></rect>
          <rect class="cu-card" x="308" y="258" width="108" height="132" rx="6"></rect>
          <ellipse class="cu-pen" cx="240" cy="46" rx="230" ry="34" pathLength="1"></ellipse>
          <path class="cu-pen" d="M172 404 L186 404 M172 398 L172 410 M186 398 L186 410" pathLength="1"></path>
          <path class="cu-pen" d="M440 160 C 470 150, 480 120, 470 104" pathLength="1"></path>
          <circle class="cu-sw cu-sw1" cx="530" cy="250" r="26"></circle>
          <circle class="cu-sw cu-sw2" cx="590" cy="250" r="26"></circle>
          <text class="cu-aa" x="520" y="370">Aa</text>
        </svg>
        {care.notes.map((note, index) => <span class={`cu-note cu-n${index + 1}`}>{note}</span>)}
      </div>
      <figcaption class="cu-cap rv">
        <p class="cu-k">{care.workK}</p>
        <p class="cu-case">{care.workTitle}</p>
        <p class="cu-inv">{care.workP}</p>
        <a class="btn" href={routes[lang].contact}>{care.workCta} <span class="ar" aria-hidden="true">→</span></a>
      </figcaption>
    </figure>
  </section>

  <section class="sec sec--flush w ai" aria-labelledby="ai-t">
    <div class="ai-door">
      <div class="ai-tx">
        <Label class="lab--head" k={h.ai.k} v={h.ai.v} />
        <h2 id="ai-t" class="d2 rv" set:html={h.ai.title} />
        <p class="p" set:html={terms(h.ai.p)} />
        <div class="ai-acts">
          <a class="btn btn--l" href={routes[lang].contact}>{h.ai.cta} <span class="ar" aria-hidden="true">→</span></a>
          <a class="ln" href={routes[lang].lodge}>{h.ai.more} <span class="ar" aria-hidden="true">→</span></a>
        </div>
      </div>
      <AiChat lang={lang} class="ai-chat" threshold={0.35} />
      <div class="ai-nums">
        <p class="ai-nums-k">{h.ai.numsK}</p>
        <ul>
          {h.ai.nums.map((item) => (
            <li class="rv">
              <b>{item.n}</b>
              <span>{item.t}</span>
              <a href={item.url} rel="noopener" target="_blank">{item.src}</a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="sec sec--flush w" aria-labelledby="noi-t">
    <div class="g">
      <div class="us-h">
        <Label class="lab--head" k={h.us.k} />
        <h2 id="noi-t" class="d2 rv" set:html={h.us.title} />
      </div>
      <div class="us-tx">
        {h.us.p.map((paragraph) => <p class="p">{paragraph}</p>)}
        <p class="sign">{h.us.sign}</p>
      </div>
    </div>
  </section>

  <section class="sec sec--flush w" aria-labelledby="ix-t">
    <div class="g">
      <div class="ix-h">
        <Label class="lab--head" k={h.index.k} />
        <h2 id="ix-t" class="d2 rv" set:html={h.index.title} />
      </div>
    </div>
    <ol class="ix">
      {indexKeys.map((key) => (
        <li>
          <a href={routes[lang][key]}>
            <span class="ix-n">{t.chapters[key]}</span>
            <span class="ix-t">{t.pages[key]}</span>
            <span class="ix-d">{h.index.items[key]}</span>
            <span class="ix-img" aria-hidden="true"><Image src={thumbFor[key]} widths={[240, 480]} sizes="(max-width: 860px) 33vw, 16vw" alt="" loading="lazy" decoding="async" /></span>
          </a>
        </li>
      ))}
    </ol>
  </section>
</Base>

<script>
  import '../elements/home-intro';
  import '../elements/lake-ripples';
  import '../elements/in-view';
</script>
