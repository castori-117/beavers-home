---
/* The mark: the AI square over two orange teeth. `teeth` drops the square. */
interface Props {
  class?: string;
  width?: number;
  height?: number;
  teeth?: boolean;
}

const { class: className, width = 17, height = 21, teeth = false } = Astro.props;
---
<svg class:list={['mk', className]} width={width} height={height} viewBox={teeth ? '0 8 18 14' : '0 0 18 22'} aria-hidden="true">
  {!teeth && <rect class="mk-ai" x="6" y="0" width="6" height="6"></rect>}
  <path class="mk-t" d="M0 8h8v11a3 3 0 0 1-3 3H3a3 3 0 0 1-3-3z"></path>
  <path class="mk-t" d="M10 8h8v11a3 3 0 0 1-3 3h-2a3 3 0 0 1-3-3z"></path>
</svg>
